# 复制为 .env 后按需填写；全部留空 = 离线体验模式（哈希向量 + BM25 + 词法精排 + 抽取式回答）。
# 更推荐在前端「模型配置」页里配置并激活模型（保存在 SQLite，优先级高于本文件）。

# Anthropic（默认 LLM：claude-opus-5-5）
ANTHROPIC_API_KEY=

# OpenAI 兼容端点（OpenAI / DeepSeek / DashScope / SiliconFlow / vLLM / Ollama）
OPENAI_API_KEY=
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# 是否允许使用 MinerU（已安装 mineru[torch] 时生效；false 则强制用内置解析器）
USE_MINERU=true
# MinerU 云端 API 密钥（策略配置里「解析方式」选云端 API 时使用；页面上填的密钥优先）
# MINERU_API_KEY=

# 数据目录（SQLite / 上传 / 索引 / LanceDB）整体指到别处：联调、临时环境用，默认 ./data
# DATA_DIR=

# 端口（start.sh 使用；被占用时自动顺延）
BACKEND_PORT=8000
FRONTEND_PORT=5173

# 飞书 / Lark 自建应用（「飞书文档」页里填的优先；页面上没填时用这里）
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_DOMAIN=feishu            # feishu = open.feishu.cn；lark = open.larksuite.com
# FEISHU_API_BASE=                # 经代理 / 私有化部署访问开放平台时覆盖接口地址
